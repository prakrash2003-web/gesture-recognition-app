# Backend configuration. Copy to `.env` for local overrides (python-dotenv is
# pulled in by uvicorn[standard] and loads it automatically), or set these in the
# hosting provider's dashboard for production. None of these are secrets.

# Comma-separated browser origins allowed for CORS *and* the WebSocket Origin check.
# Local default is localhost:5173. In production: your deployed frontend URL, e.g.
# GESTUREFLOW_ALLOWED_ORIGINS=https://gestureflow.vercel.app
GESTUREFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Which classifier a new connection starts with: "rule" (baseline) or "ml"
# (trained model; falls back to "rule" if the model file is missing).
GESTUREFLOW_CLASSIFIER=rule

# Override the trained-model / report locations (defaults resolve next to the app).
# GESTUREFLOW_MODEL_PATH=ml/models/gesture_clf.joblib
# GESTUREFLOW_MODEL_REPORT=ml/reports/comparison.json

# Allow WebSocket connections with any Origin (or none). Only for local tooling.
# GESTUREFLOW_WS_ALLOW_ANY_ORIGIN=1
