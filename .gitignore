# ---------- ML data / models (Phase 7) ----------
# Collected landmark datasets (webcam captures) and trained model files are not
# committed: datasets are personal, models are regenerated with `python -m ml.train`.
# The small metric reports in backend/ml/reports/ ARE committed.
backend/ml/data/*
!backend/ml/data/.gitkeep
backend/ml/models/*
!backend/ml/models/.gitkeep
*.joblib

