# Copy this file to `.env` for local development. Vite only exposes variables that
# start with VITE_ to the browser code (via import.meta.env.VITE_...).
#
# Local: point at a backend running on your machine (see backend/README.md).
# Production: set these in the Vercel project settings to the deployed backend URL
# (https:// for the API, wss:// for the WebSocket). A production build with these
# unset logs an error and falls back to localhost.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
