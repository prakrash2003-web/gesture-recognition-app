# Copy this file to `.env` for local development. Vite only exposes variables that
# start with VITE_ to the browser code (via import.meta.env.VITE_...).
#
# These point at a backend running locally (see backend/README.md). In production
# (Phase 8) they are set to the deployed Hugging Face Space URL instead.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
